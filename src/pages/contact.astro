---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import Offices from '../components/sections/Offices.astro';
import Faq from '../components/sections/Faq.astro';
import { site } from '../lib/site';
const contact = await site('contact');
---
<Base
  title="Контакты — Marby"
  description="Свяжитесь с командой Marby: бесплатная консультация по покупке, продаже и управлению недвижимостью."
>
  <PageHeader label={contact.header.label} title={contact.header.title} />
  <Offices />
  <Faq />
</Base>

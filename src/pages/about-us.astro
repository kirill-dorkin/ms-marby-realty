---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import AboutVision from '../components/sections/AboutVision.astro';
import AboutYears from '../components/sections/AboutYears.astro';
import AboutBeliefs from '../components/sections/AboutBeliefs.astro';
import Faq from '../components/sections/Faq.astro';
import Team from '../components/sections/Team.astro';
import { site } from '../lib/site';
const about = await site('about');
---
<Base
  title="О нас — Marby"
  description="Команда Marby, наша история и принципы работы с недвижимостью."
>
  <PageHeader label={about.header.label} title={about.header.title} />
  <AboutVision />
  <AboutYears />
  <AboutBeliefs />
  <Faq />
  <Team />
</Base>
